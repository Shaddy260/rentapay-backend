# RentaPay backend - environment variables
# Copy this file to .env and fill in real values. Nothing here is a
# real secret - every value below is a placeholder.

# ---------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# ---------------------------------------------------------------------
# Supabase (required - server exits on boot without these two)
# ---------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# ---------------------------------------------------------------------
# Auth / JWT
# ---------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Super Admin login (used for the hidden /admin-portal-access-secret
# style route - see AdminPortalAccess.jsx and auth.controller.js).
# SUPER_ADMIN_PASSWORD_HASH is a bcrypt hash, not a plaintext password
# - generate one with: node -e "console.log(require('bcrypt').hashSync('yourpassword', 10))"
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PHONE=254700000000
SUPER_ADMIN_PASSWORD_HASH=
# Set to "true" once ready to require OTP on super admin login.
SUPER_ADMIN_OTP_ENABLED=false

# DEV-ONLY diagnostic logging for login attempts. Never set this in
# production - see the warning next to its usage in auth.controller.js.
DEBUG_AUTH=false

# ---------------------------------------------------------------------
# Frontend URL(s) - used both to build links in emails/SMS/WhatsApp
# notifications AND as the CORS allowlist in production (see
# server.js). Comma-separate multiple origins (e.g. prod + staging).
# Not required in development - CORS is left open when NODE_ENV isn't
# "production".
# ---------------------------------------------------------------------
FRONTEND_URL=https://rentapay.co.ke
PUBLIC_SIGNUP_URL=https://rentapay.co.ke/register

# ---------------------------------------------------------------------
# M-Pesa Daraja (STK Push)
# ---------------------------------------------------------------------
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=https://your-backend-domain.com/api/payments/callback
# Set to "true" in local/dev to skip real Safaricom calls and complete
# payments via /api/dev/simulate-payment-success instead (see
# dev.controller.js). Must never be "true" in production.
MOCK_DARAJA=false

# ---------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@rentapay.co.ke
SUPPORT_EMAIL=support@rentapay.co.ke
ADMIN_NOTIFICATION_EMAIL=admin@rentapay.co.ke

# ---------------------------------------------------------------------
# Web Push (VAPID)
# ---------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@rentapay.co.ke

# ---------------------------------------------------------------------
# Google Sign-In
# ---------------------------------------------------------------------
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------
# Error tracking (Sentry) - optional, disabled cleanly if unset
# ---------------------------------------------------------------------
SENTRY_DSN=

# ---------------------------------------------------------------------
# AI support chat providers (supportChat.service.js tries these in
# order as a fallback chain - only the ones you set will be usable)
# ---------------------------------------------------------------------
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------
# Platform review links (shown to tenants/landlords after support
# interactions)
# ---------------------------------------------------------------------
GOOGLE_REVIEW_URL=
FACEBOOK_REVIEW_URL=

# ---------------------------------------------------------------------
# Brand Ambassador tuning (all optional - sensible defaults baked in)
# ---------------------------------------------------------------------
BA_QUALIFICATION_DRY_RUN=false
BA_SECURITY_REPORT_WINDOW_DAYS=30
BA_RAPID_FIRE_WINDOW_MINUTES=60
BA_RAPID_FIRE_THRESHOLD=5

# ---------------------------------------------------------------------
# Notifications batching (optional - default is 30 minutes)
# ---------------------------------------------------------------------
NOTIFICATION_BATCH_WINDOW_MINUTES=30
