# Copy this file to .env and fill in real values.
# cp .env.example .env

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Auth / JWT ---
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Google Login (item 2: "Google / Facebook login") ---
# The OAuth 2.0 Client ID from console.cloud.google.com
# (APIs & Services -> Credentials -> OAuth client ID -> Web application).
# This value is NOT secret - it's the same ID the frontend sends to
# Google. Set it here too so the backend can verify that a Google ID
# token was actually issued for THIS app (not some other one) before
# trusting the email address inside it.
GOOGLE_CLIENT_ID=

# --- M-Pesa Daraja ---
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=
DARAJA_ENV=sandbox
MOCK_DARAJA=true

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SUPPORT_EMAIL=

# --- Web Push ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Super Admin (blueprint 13.3 - hidden admin URL) ---
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PHONE=
SUPER_ADMIN_PASSWORD_HASH=
SUPER_ADMIN_OTP_ENABLED=true

# --- Misc ---
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
DEBUG_AUTH=false
SENTRY_DSN=
